    "basePath": "/docs",
    "description": "Acme developer docs",
    "favicon": "fern/assets/favicon.png"
  },
  "theme": {
    "colors": {
      "primary": "#418326",
      "light": "#418326",
      "dark": "#ADFF8C"
    },
    "logo": {
      "light": "fern/assets/logo-light.svg",
      "dark": "fern/assets/logo-dark.svg"
    }
  },
  "navigation": [
    {
      "group": "Introduction",
      "pages": [
        {
          "page": "introduction/introduction",
